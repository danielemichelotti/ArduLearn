<!doctype html>
<html lang="it">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% if title and title != sito.nome %}{{ title }} · {% endif %}{{ sito.nome }}</title>
<meta name="description" content="{{ descrizione or sito.descrizione }}">
<link rel="icon" href="/img/logo.svg" type="image/svg+xml">
<link rel="stylesheet" href="/assets/sito.css">
</head>
<body>
<header class="nav">
  <div class="wrap nav-in">
    <a class="marchio" href="/"><img src="/img/logo-bianco.svg" alt="" width="34" height="34"><span>{{ sito.nome }}</span></a>
    <input type="checkbox" id="menu-t" class="menu-t"><label for="menu-t" class="menu-b" aria-label="Menu">☰</label>
    <nav class="menu">
      <a href="/prova/"{% if page.url == "/prova/" %} class="on"{% endif %}>Prova online</a>
      <a href="/training/"{% if page.url == "/training/" %} class="on"{% endif %}>Training</a>
      <a href="/manuale/"{% if page.url == "/manuale/" %} class="on"{% endif %}>Manuale</a>
      {%- for p in collections.pagine %}{% if p.data.menu %}
      <a href="{{ p.url }}"{% if page.url == p.url %} class="on"{% endif %}>{{ p.data.title }}</a>
      {%- endif %}{% endfor %}
      <a href="/chi-sono/"{% if page.url == "/chi-sono/" %} class="on"{% endif %}>Chi sono</a>
      <a href="/scarica/" class="cta">Scarica</a>
    </nav>
  </div>
</header>
<main>
{{ content | safe }}
</main>
<footer class="piede">
  <div class="wrap piede-in">
    <div>
      <b>{{ sito.nome }}</b> · ideato e realizzato da {{ sito.autore }}<br>
      Software libero (GPL-3.0) · <a href="{{ sito.github }}">progetto su GitHub</a><br>
      <a href="/privacy/">Privacy</a> · <a href="#" data-privacy-pref>Preferenze privacy</a>
    </div>
    <div class="dono">
      <span class="mano">se ti è utile, offrimi un caffè</span>
      <a class="btn-dono" href="{{ sito.donazione }}" target="_blank" rel="noopener">♥ Fai una donazione</a>
    </div>
  </div>
  <div class="wrap nota-marchi">Arduino, UNO e Mega sono marchi di Arduino S.r.l.; la shield Ethernet &amp; PoE DFR0850 è un prodotto DFRobot. ArduLearn è un progetto indipendente, non affiliato a questi produttori.</div>
</footer>
<script>window.AL_PRIVACY = { contatore: {{ sito.contatore | dump | safe }}, domini: {{ sito.domini_contatore | dump | safe }}, base: {{ "/" | url | dump | safe }} };</script>
<script src="/assets/privacy.js"></script>
</body>
</html>
